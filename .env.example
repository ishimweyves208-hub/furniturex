# ---------------------------------------------------------------------------
# FurnitureX environment configuration
# Copy to .env.local and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public canonical URL of the deployment (no trailing slash)
APP_URL=http://localhost:3000

# MongoDB Atlas connection string (SRV) and logical database name
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=furniturex

# 32+ byte random secret used to sign short-lived tokens (password reset, email verification)
# Generate: openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (optional). Password recovery and email verification
# require this. The app never claims email was sent when it is not configured.
# Uses the Resend HTTP API.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="FurnitureX <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Bootstrap only (used by `npm run create-superadmin` — never read by the app)
# ---------------------------------------------------------------------------
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Seed demo catalogue. Only has an effect when running `npm run seed`.
SEED_DEMO=false
